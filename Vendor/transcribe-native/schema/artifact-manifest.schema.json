{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VoicePen native GigaAM candidate manifest",
  "type": "object",
  "required": ["schema_version", "candidate", "acceptance", "interface_version", "target", "profile", "upstream", "ggml", "source", "model", "licenses", "files", "metal_resources", "head_decision"],
  "properties": {
    "schema_version": {"const": 1},
    "acceptance": {"enum": ["unaccepted", "accepted"]},
    "interface_version": {"const": "0.4.0"},
    "candidate": {"type": "string", "minLength": 1},
    "target": {"type": "object", "required": ["platform", "architecture", "deployment_target"]},
    "profile": {"type": "object", "required": ["id", "version", "window_policy", "weight_storage", "activations", "frontend", "encoder", "ctc_projection", "ctc_search"]},
    "model": {"type": "object", "required": ["source_revision", "weights_sha256", "gguf_sha256", "languages"]},
    "source": {"type": "object", "required": ["upstream", "patches"]},
    "licenses": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
  }
}
