--- /dev/null
+++ b/tests/gigaam_ctc_confidence_unit.cpp
@@ -0,0 +1,38 @@
+#include "arch/gigaam/decoder.h"
+#include <cassert>
+#include <cmath>
+#include <limits>
+#include <vector>
+using namespace transcribe::gigaam;
+int main() {
+    const std::vector<float> raw = {2,0,-2, 4,0,-2, 0,0,5, 1,0,-2, 0,4,-2};
+    std::vector<int> ids,frames,old_ids,old_frames;
+    std::vector<float> p;
+    assert(collapse_ctc_logits(raw.data(),5,3,old_ids,old_frames)==TRANSCRIBE_OK);
+    assert(collapse_ctc_logits(raw.data(),5,3,ids,frames,&p)==TRANSCRIBE_OK);
+    assert(ids==old_ids && frames==old_frames);
+    assert((ids==std::vector<int>{0,0,1}));
+    assert((frames==std::vector<int>{0,3,4}));
+    assert(p.size()==3);
+    assert(std::abs(p[0]-1.0/(1.0+std::exp(-4.0)+std::exp(-6.0)))<1e-6);
+    auto shifted=raw;for(auto & x:shifted)x+=100;
+    std::vector<float> shifted_p;
+    assert(collapse_ctc_logits(shifted.data(),5,3,ids,frames,&shifted_p)==TRANSCRIBE_OK);
+    for(size_t i=0;i<p.size();++i)assert(std::abs(p[i]-shifted_p[i])<1e-6);
+    auto log_probs=raw;
+    for(int t=0;t<5;++t){double sum=0;for(int c=0;c<3;++c)sum+=std::exp(raw[t*3+c]);for(int c=0;c<3;++c)log_probs[t*3+c]-=std::log(sum);}
+    std::vector<float> normalized_p;
+    assert(collapse_ctc_logits(log_probs.data(),5,3,ids,frames,&normalized_p,true)==TRANSCRIBE_OK);
+    for(size_t i=0;i<p.size();++i)assert(std::abs(p[i]-normalized_p[i])<1e-6);
+    const std::vector<float> blank={0,0,5, 0,0,5};
+    assert(collapse_ctc_logits(blank.data(),2,3,ids,frames,&p)==TRANSCRIBE_OK);
+    assert(ids.empty() && frames.empty() && p.empty());
+    const std::vector<float> uniform={0,0,0};
+    assert(collapse_ctc_logits(uniform.data(),1,3,ids,frames,&p)==TRANSCRIBE_OK);
+    assert(std::abs(p[0]-1.0/3)<1e-6);
+    const std::vector<float> invalid={0,std::numeric_limits<float>::quiet_NaN(),-1};
+    assert(collapse_ctc_logits(invalid.data(),1,3,ids,frames,&p)==TRANSCRIBE_OK);
+    assert(ids.size()==1 && std::isnan(p[0]));
+    assert(collapse_ctc_logits(nullptr,0,3,ids,frames,&p)==TRANSCRIBE_ERR_INVALID_ARG);
+    assert(ids.empty() && frames.empty() && p.empty());
+}
